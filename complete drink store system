let drinks = [
    { name: "Coke", price: 25, stock: 20 },
    { name: "Milk Tea", price: 85, stock: 15 },
    { name: "Orange Juice", price: 40, stock: 10 },
    { name: "Water", price: 15, stock: 30 }
];

drinks.forEach(drink => {
    console.log("Drink: " + drink.name);
    console.log("Price: ₱" + drink.price);
    console.log("Stock: " + drink.stock);

    if (drink.stock > 0) {
        console.log("Status: Available");
    } else {
        console.log("Status: Out of Stock");
    }

    console.log("--------------------");
});
